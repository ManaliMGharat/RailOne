# ==========================================
# RailOne Railway Platform - Environment Variables
# ==========================================

# Database Connection (SQLite by default for zero-friction local run, PostgreSQL for Docker / Cloud)
DATABASE_URL=sqlite:///./railone.db
# For PostgreSQL in Docker / Production:
# DATABASE_URL=postgresql://railone_user:railone_password@localhost:5432/railone_db

# Security & JWT Configuration
SECRET_KEY=railone-production-secure-random-secret-key-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cache & Background Tasks
REDIS_URL=redis://localhost:6379/0

# Client App URLs & CORS
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# Demo Account Credentials (For Seed / Local Sandbox)
DEMO_ADMIN_EMAIL=admin@railone.local
DEMO_ADMIN_PASSWORD=Admin@123
DEMO_USER_EMAIL=user@railone.local
DEMO_USER_PASSWORD=User@123
